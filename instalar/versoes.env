# Estudio de Reels: versoes fixas de cada programa.
# Formato: CHAVE=VALOR, uma por linha. Linhas com # sao comentario.
# O instalador do Mac e o do Windows leem este arquivo do mesmo jeito (corta no primeiro "=").
# Conferido nas fontes oficiais em 12/11/2026. Ao trocar uma versao, troque tambem o SHA256 da mesma linha de baixo.

# Node (motor que monta os videos). LTS 24. O SHA256 vem do SHASUMS256.txt oficial da mesma versao.
NODE_VERSAO=24.22.3

# uv (instala o Python e os ouvidos). O SHA256 vem do arquivo .sha256 oficial ao lado de cada download.
UV_VERSAO=0.13.7
PYTHON_VERSAO=3.12

# FFmpeg (a tesoura). Mesma versao testada pelo HyperFrames 0.9.20 (8.0.1) onde existe.
FFMPEG_VERSAO=8.0.1

# Mac: builds estaticas de martin-riedl.de, com zscale (libzimg) e libx264. O ffprobe fica na mesma pasta, trocando ffmpeg.zip por ffprobe.zip.
FFMPEG_MAC_URL_ARM64=https://ffmpeg.martin-riedl.de/download/macos/arm64/1766430132_8.0.1/ffmpeg.zip
FFMPEG_MAC_SHA256_ARM64=c56f4e2b2ce26a61becf890d8da3415347a1d7d4418cb514915f21612358b790
FFPROBE_MAC_SHA256_ARM64=ad74fb26500f9a67864611856a655636d910b47a21c9ee2f2f7bc7cbaa45bbb2
FFMPEG_MAC_URL_X64=https://ffmpeg.martin-riedl.de/download/macos/amd64/1766437297_8.0.1/ffmpeg.zip
FFMPEG_MAC_SHA256_X64=a6c41c69e829697e408308f1ecd6acdfd0d0a84973ff3a6bf782beba83885ed6
FFPROBE_MAC_SHA256_X64=a09b01e8f54ccdbeb661d48952f412edb858860b38ec7fd1c3901a645e3a3b04

# Mac, reserva: usada so se a principal vier sem um filtro necessario (FFMPEG_INCOMPLETO) ou nao baixar.
FFMPEG_MAC_RESERVA_ARM64=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
FFMPEG_MAC_RESERVA_SHA256_ARM64=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFPROBE_MAC_RESERVA_SHA256_ARM64=fcbe839537485eaee7a7a8bc5cbc0f90d53617e80943e8a5b2e31cb851197ea6
FFMPEG_MAC_RESERVA_X64=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip
FFMPEG_MAC_RESERVA_SHA256_X64=7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4
FFPROBE_MAC_RESERVA_SHA256_X64=2322438ed2f6319a691291b247d09c69dcaa3a982460d1f269a7e1af335cfdfd

# Windows x64: GyanD/codexffmpeg, release 8.0.1, "essentials". SHA256 = digest oficial do asset no GitHub.
FFMPEG_WIN_URL_X64=https://github.com/GyanD/codexffmpeg/releases/download/8.0.1/ffmpeg-8.0.1-essentials_build.zip
FFMPEG_WIN_SHA256_X64=e2aaeaa0fdbc397d4794828086424d4aaa2102cef1fb6874f6ffd29c0b88b673
FFMPEG_WIN_RESERVA_X64=https://github.com/GyanD/codexffmpeg/releases/download/8.0.1/ffmpeg-8.0.1-full_build.zip
FFMPEG_WIN_RESERVA_SHA256_X64=467cde100a47ed4b03a897988aeb4a296890c1e2b2d2864204657d002bc5fb90

# Windows ARM64: BtbN, tag fixa (ramo 8.1). As tags "autobuild" do BtbN somem depois de um tempo;
# por isso a reserva e o ramo 8.1 "latest". A reserva nao tem SHA256 fixo aqui: o instalador baixa o
# checksums.sha256 que o BtbN publica na mesma release e confere por ele. Sem hash, nao instala.
FFMPEG_WIN_URL_ARM64=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-11-12-39/ffmpeg-n8.1.3-35-gf1acb0a266-winarm64-gpl-8.1.zip
FFMPEG_WIN_SHA256_ARM64=2c66859205ac666fa9204cbaf8271e75d65c912e6ca896cf2ee75cb4bf1f4718
FFMPEG_WIN_RESERVA_ARM64=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-winarm64-gpl-8.1.zip
FFMPEG_WIN_RESERVA_SHA256_ARM64=

# yt-dlp (baixador de videos). SHA256 vem do SHA2-256SUMS oficial da mesma release.
YTDLP_VERSAO=2026.10.26

# earshot (ouvido de som). Commit da release 0.4.1.
EARSHOT_COMMIT=4ac3d2ac2b151e1c23376f9ce7f3047a17050013

# gh (so para o comando unico V2, repositorio privado). SHA256 vem do checksums.txt oficial.
GH_VERSAO=2.103.3

# Git para Windows (opcional, so com Claude no Windows).
GIT_WINGET_ID=Git.Git

# Videos de exemplo: tamanho estimado por minuto de video. O instalador calcula o total (plano, passo
# referencias) a partir de duracao_s de 1-referencias/links.json. E o unico lugar desse calculo.
REFERENCIA_MB_POR_MINUTO=15

# Limites.
ESPACO_MINIMO_GB=12
ESPACO_MINIMO_VERIFICAR_GB=2
MEMORIA_MINIMA_GB=8
MAC_MINIMO=13.5
WINDOWS_BUILD_MINIMO=19045

# Atualizacao: endereco do zip da versao mais nova (conta autonom-ia, repositorio video-edit-autonomia).
# O "atualizar" so aceita https://github.com/autonom-ia/video-edit-autonomia/... e exige, ao lado do zip, o arquivo
# estudio-de-reels.zip.sha256 publicado na mesma release (ver comandos-unicos.md, "Publicar uma versao").
ESTUDIO_ATUALIZAR_URL=https://github.com/autonom-ia/video-edit-autonomia/releases/latest/download/estudio-de-reels.zip

# Modelos de fala (faster-whisper) com revisao fixa no Hugging Face. O large-v3-turbo mudou de
# mobiuslabsgmbh para dropbox-dash; o endereco antigo redireciona e a revisao continua valendo.
FALA_MODELO_REVISAO=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
FALA_MODELO_REVISAO_SMALL=536b0662742c02347bc0e980a01041f333bce120
